# Salin ke .env.local lalu ubah nilainya. Variabel EXPO_PUBLIC_* ikut ke bundle aplikasi; jangan isi rahasia.

# Mode tes clock-in (hanya development): posisi perangkat di mana pun dianggap titik kantor.
# Akurasi GPS tetap dicek. Restart `pnpm dev:mobile` setelah mengubahnya.
EXPO_PUBLIC_TEST_ANY_LOCATION=false

# Alamat API. Kosongkan untuk memakai mock Prism (port 4010) di komputer yang menjalankan Metro.
# Contoh backend lokal: http://192.168.1.10:8080/v1 (pakai IP Mac, bukan localhost).
EXPO_PUBLIC_API_URL=
