# Salin ke .env.local lalu ubah nilainya. Variabel NEXT_PUBLIC_* ikut ke bundle browser; jangan isi rahasia.

# Mode tes clock-in (hanya development): posisi perangkat di mana pun dianggap titik kantor.
# Akurasi GPS tetap dicek. Restart `pnpm dev:web` setelah mengubahnya.
NEXT_PUBLIC_TEST_ANY_LOCATION=false
