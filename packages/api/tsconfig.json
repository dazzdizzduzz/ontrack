{
  // Sama dengan tsconfig.base.json, tetapi tidak memakai "extends": package ini juga dibuka
  // lewat symlink pnpm (apps/*/node_modules/@on-track/...), dan di sana jalur relatif
  // "../../tsconfig.base.json" tidak ditemukan. Ubah keduanya bila salah satu diubah.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src"]
}
